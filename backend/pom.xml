<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Phase 2: esqueleto. Toda regla de juego vivirá en com.pelusa.domain (Phase 3),
       este pom solo declara el stack confirmado en ADR-002/ADR-003. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.7</version>
    <relativePath/>
  </parent>

  <groupId>com.pelusa</groupId>
  <artifactId>pelusa-game</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>pelusa-game</name>
  <description>Pelusas — backend fuente de verdad de las reglas (Phase 2: foundation)</description>

  <properties>
    <java.version>25</java.version>
    <mockito.version>5.20.0</mockito.version>
    <!-- Flyway 11.x permite compatibilidad con PostgreSQL 18 en el stack. -->
    <flyway.version>11.20.3</flyway.version>
    <!-- Umbrales de cobertura del gate de JaCoCo (mvn verify). -->
    <jacoco.line.minimum>1.00</jacoco.line.minimum>
    <jacoco.branch.minimum>1.00</jacoco.branch.minimum>
  </properties>

  <dependencies>
    <!-- REST + validación de DTOs (API_CONTRACT) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Persistencia + migraciones (DATA_MODEL V1) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- Flyway 10+ separa el soporte de cada motor en módulos. Sin estos,
         Flyway detecta la DB pero falla con "Unsupported Database". -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-hsqldb</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Observabilidad: health real con DB -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Postgres dev/prod -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- H2 en runtime: permite correr local sin Docker (perfil local).
         Prod sigue usando Postgres por variables de entorno. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Expone ${org.mockito:mockito-core:jar} = ruta real del jar resuelto.
           Antes el agente apuntaba a una versión fija de byte-buddy en ~/.m2:
           al subir Spring Boot esa ruta dejaba de existir y los tests no arrancaban. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- JDK 21+ avisa si Mockito se auto-adjunta; cargarlo como agente es lo recomendado. -->
          <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
        </configuration>
      </plugin>
      <!-- Cobertura: mvn verify genera target/site/jacoco/index.html y falla
           si la cobertura de líneas o ramas baja del umbral. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.14</version>
        <configuration>
          <excludes>
            <!-- Solo el arranque (main → SpringApplication.run): no tiene lógica. -->
            <exclude>com/pelusa/PelusaApplication.class</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.minimum}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.branch.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Mutación: mvn test-compile org.pitest:pitest-maven:mutationCoverage
           → target/pit-reports/index.html. Falla si el mutation score < 90 %. -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>1.30.1</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>1.2.3</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <param>com.pelusa.*</param>
          </targetClasses>
          <excludedClasses>
            <param>com.pelusa.PelusaApplication</param>
          </excludedClasses>
          <targetTests>
            <param>com.pelusa.*</param>
          </targetTests>
          <mutators>
            <mutator>DEFAULTS</mutator>
          </mutators>
          <outputFormats>
            <param>HTML</param>
            <param>XML</param>
          </outputFormats>
          <timestampedReports>false</timestampedReports>
          <mutationThreshold>90</mutationThreshold>
          <threads>4</threads>
          <!-- PIT no hereda el argLine de surefire: el agente de JaCoCo no aporta
               nada aquí y solo duplica instrumentación. Mockito sí va como agente. -->
          <parseSurefireArgLine>false</parseSurefireArgLine>
          <jvmArgs>
            <value>-javaagent:${org.mockito:mockito-core:jar}</value>
          </jvmArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
