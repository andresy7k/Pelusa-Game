# Copiar a .env (nunca commitear el real). Ver application.yml.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pelusa
SPRING_DATASOURCE_USERNAME=pelusa
SPRING_DATASOURCE_PASSWORD=pelusa
# Opcional: solo si el front llama cross-origin al backend (modo directo).
# Con el proxy /api de Vercel no hace falta.
# Ej: https://pelusa.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
