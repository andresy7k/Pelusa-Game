# Copiar a .env (nunca commitear el real). Ver application.yml.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pelusa
SPRING_DATASOURCE_USERNAME=pelusa
SPRING_DATASOURCE_PASSWORD=pelusa
# En dev el front usa el proxy de Vite (mismo origen), así que no hace falta.
# En Render, el Blueprint inyecta la URL del static site automáticamente.
# Si el navegador llama directo al backend, agregá el origen exacto (coma-separado).
# Ej: https://pelusa-frontend.onrender.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
